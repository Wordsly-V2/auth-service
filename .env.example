# ── auth-service ──────────────────────────────────────────────────────────
# Copy to `.env` and fill in. Vars marked (required) are validated at boot
# (src/config/validate-env.ts) — the service will refuse to start without them.

# HTTP port (defaults to 3001).
PORT=3001

# Comma-separated list of allowed CORS origins.
CORS_ENABLED_ORIGINS=http://localhost:4000

# (required) The address browsers reach this service on, THROUGH the gateway.
# It is the service's whole public identity: the `iss` claim on every token and
# the base of the discovery document. Must be the public URL — never the
# in-cluster hostname — and must match the other services' JWT_ISSUER, which
# they compare exactly.
PUBLIC_BASE_URL=http://localhost:3000

# Proxy hops between this service and the client. The gateway proxies to it, so
# this must be the gateway's own TRUST_PROXY_HOPS + 1, or every request's IP is
# the gateway's and the refresh flow's network-change logging means nothing.
TRUST_PROXY_HOPS=1

# (required) PostgreSQL connection string.
DATABASE_URL=postgresql://wordsly:wordsly@localhost:5432/auth?schema=public

# (required) Redis connection string.
REDIS_URL=redis://localhost:6379

# ── JWT signing keys ──────────────────────────────────────────────────────────
# (required)
#
# The key set, base64-encoded JSON:
#   [ { "kid": "2026-09", "privateKey": "<base64 of a PKCS#8 PEM>" }, ... ]
# Both the outer JSON and each PEM are base64-wrapped because multi-line PEMs
# survive poorly in .env files and compose `environment:` blocks.
#
# Generate a key and build the value:
#   npm run keys:generate                 # a fresh single-key set
#   npm run keys:generate -- --append     # ROTATING: adds to the set in this .env
# The two env lines go to stdout; notes and warnings go to stderr.
#
# Every key listed is published at /.well-known/jwks.json, so tokens signed by a
# previous key keep verifying. Rotation: append the new key (--append, which is
# why it exists — a fresh set would DROP the old key and sign out everyone still
# holding a token it signed), point JWT_ACTIVE_KID at the new kid, restart, and
# drop the old key only once the longest-lived token issued under it has expired
# — that is JWT_REFRESH_TOKEN_EXPIRES_IN below, not JWT_EXPIRES_IN.
JWT_SIGNING_KEYS=
# Which kid signs new tokens. Optional — defaults to the first key in the set.
# If set, it must name a key in that set, or boot fails.
JWT_ACTIVE_KID=

# Audiences. These are what stop a refresh token being used as an access token,
# so the two must differ.
JWT_AUDIENCE=wordsly-api
JWT_REFRESH_AUDIENCE=wordsly-auth

JWT_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=30d

# ── Google OAuth ──────────────────────────────────────────────────────────────
# (required) The handshake runs in this service. GOOGLE_REDIRECT_URI is a public
# URL, so it points at the gateway, which proxies /auth/** here unchanged.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/redirect
GOOGLE_FRONTEND_REDIRECT_URL=http://localhost:4000/auth/redirect

# ── Refresh token delivery ────────────────────────────────────────────────────
# `cookie` keeps the refresh token in an httpOnly cookie; `body` returns it to
# the client, which cross-origin deployments need.
REFRESH_TOKEN_DELIVERY=cookie
REFRESH_TOKEN_COOKIE_HTTP_ONLY=true
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_SAME_SITE=lax
REFRESH_TOKEN_COOKIE_MAX_AGE=30d
REFRESH_TOKEN_COOKIE_PATH=/auth

# (required) Shared secret for service → service internal calls.
INTERNAL_SERVICE_TO_SERVICE_TOKEN=
