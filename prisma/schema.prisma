// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model UserLogin {
  id             String @id @db.Uuid
  providerUserId String @unique @map("provider_user_id")
  provider       String @map("provider")

  status String @map("status")

  /// Authorization roles (e.g. "admin"), carried in the access token's `roles`
  /// claim. Granted by ADMIN_EMAILS at login or `npm run admin:grant`; nothing
  /// removes a role automatically.
  roles String[] @default([]) @map("roles")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  users        User[]
  refreshToken RefreshToken[]

  @@map("user_logins")
}

model User {
  id String @id @db.Uuid

  userLoginId String    @unique @map("user_login_id") @db.Uuid
  userLogin   UserLogin @relation(fields: [userLoginId], references: [id])

  gmail       String? @unique
  displayName String  @map("display_name")
  pictureUrl  String? @map("picture_url")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([userLoginId])
  @@map("users")
}

model RefreshToken {
  id String @id @db.Uuid

  userLoginId String    @map("user_login_id") @db.Uuid
  userLogin   UserLogin @relation(fields: [userLoginId], references: [id])

  /// SHA-256 of the refresh token, never the token itself. Nothing looks a row
  /// up by this value -- `jwt_id` is the lookup key -- so storing only the hash
  /// costs nothing and keeps a database read from yielding usable credentials.
  tokenHash   String  @unique @map("token_hash")
  jwtId       String  @unique @map("jwt_id")
  /// Session id, stable across rotation. The access token carries the same value,
  /// which is what lets logout end one device's session: the access and refresh
  /// tokens no longer share a `jti`, so there is nothing else linking the pair.
  /// Not unique -- rotation deletes the old row and inserts a new one in the same
  /// transaction, and a unique constraint would make a retried transaction collide.
  sessionId   String  @map("session_id") @db.Uuid
  allocatedIp String? @map("allocated_ip")
  expiresAt   DateTime @map("expires_at") @db.Timestamptz
  /// Set when this token is exchanged. The row is kept for a short grace window
  /// so a concurrent refresh from another tab, or a retry after a lost response,
  /// gets a fresh pair instead of tripping reuse detection.
  rotatedAt   DateTime? @map("rotated_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([userLoginId])
  @@index([jwtId])
  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Transactional outbox: events written in the same transaction as the change
/// they announce, then published to Kafka by `OutboxRelayService`. A row with
/// no `publishedAt` is still owed to Kafka; one that is down or not configured
/// only delays it. `topic` is free text (no enum); `payload` is the message body.
model OutboxMessage {
  id      String  @id @db.Uuid
  topic   String
  /// Kafka message key (keeps one user's events on one partition, in order).
  key     String?
  payload Json

  /// Tries so far, and the last failure, for a stuck row to be found by hand.
  attempts  Int     @default(0)
  lastError String? @map("last_error")
  /// Not before this time: a claim leases the row until then, a failure backs off.
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz
  publishedAt   DateTime? @map("published_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([publishedAt, nextAttemptAt])
  @@map("outbox_messages")
}
