generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model UserLogin {
  id             String @id @db.Uuid
  providerUserId String @unique @map("provider_user_id")
  provider       String @map("provider")

  status String @map("status")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  users        User[]
  refreshToken RefreshToken[]

  @@map("user_logins")
}

model User {
  id String @id @db.Uuid

  userLoginId String    @unique @map("user_login_id") @db.Uuid
  userLogin   UserLogin @relation(fields: [userLoginId], references: [id])

  gmail       String? @unique
  displayName String  @map("display_name")
  pictureUrl  String? @map("picture_url")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([userLoginId])
  @@map("users")
}

model RefreshToken {
  id String @id @db.Uuid

  userLoginId String    @map("user_login_id") @db.Uuid
  userLogin   UserLogin @relation(fields: [userLoginId], references: [id])

  token       String  @unique
  jwtId       String  @unique @map("jwt_id")
  /// Session id, stable across rotation. The access token carries the same value,
  /// which is what lets logout end one device's session: the access and refresh
  /// tokens no longer share a `jti`, so there is nothing else linking the pair.
  /// Not unique -- rotation deletes the old row and inserts a new one in the same
  /// transaction, and a unique constraint would make a retried transaction collide.
  sessionId   String  @map("session_id") @db.Uuid
  allocatedIp String? @map("allocated_ip")
  expiresAt   DateTime @map("expires_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([userLoginId])
  @@index([jwtId])
  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
